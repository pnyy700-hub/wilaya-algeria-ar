<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🇩🇿 ولاية الجزائر AR</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #000;
  color: white;
  font-family: Arial, sans-serif;
  overflow: hidden;
}

#camera {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

#overlay {
  position: fixed;
  top: 12%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  text-align: center;
  pointer-events: none;
}

#wilaya {
  background: rgba(0, 90, 50, 0.85);
  border: 3px solid white;
  border-radius: 25px;
  padding: 15px 25px;
  font-size: 30px;
  font-weight: bold;
  box-shadow: 0 0 25px rgba(255,255,255,0.7);
}

#flag {
  font-size: 45px;
  margin-bottom: 5px;
}

#controls {
  position: fixed;
  bottom: 25px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  width: 90%;
  max-width: 450px;
  text-align: center;
}

button, select {
  width: 100%;
  margin: 6px 0;
  padding: 14px;
  border: none;
  border-radius: 15px;
  font-size: 18px;
  font-weight: bold;
}

button {
  background: #00843d;
  color: white;
}

select {
  background: white;
  color: #111;
}

#message {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  background: rgba(0,0,0,0.85);
  padding: 25px;
  border-radius: 20px;
  text-align: center;
  width: 85%;
}
</style>
</head>

<body>

<video id="camera" autoplay playsinline></video>

<div id="overlay">
  <div id="flag">🇩🇿</div>
  <div id="wilaya">ولاية الجزائر</div>
</div>

<div id="message">
  <h2>🇩🇿 ولاية الجزائر AR</h2>
  <p>تطبيق للتعرف على ولايات الجزائر باستخدام كاميرا الهاتف</p>
  <button onclick="startCamera()">📷 تشغيل الكاميرا</button>
</div>

<div id="controls">
  <select id="wilayaSelect" onchange="changeWilaya()">
    <option>ولاية الجزائر</option>
  </select>

  <button onclick="startCamera()">📷 الكاميرا</button>
</div>

<script>

const wilayas = [
"أدرار",
"الشلف",
"الأغواط",
"أم البواقي",
"باتنة",
"بجاية",
"بسكرة",
"بشار",
"البليدة",
"البويرة",
"تمنراست",
"تبسة",
"تلمسان",
"تيارت",
"تيزي وزو",
"الجزائر",
"الجلفة",
"جيجل",
"سطيف",
"سعيدة",
"سكيكدة",
"سيدي بلعباس",
"عنابة",
"قالمة",
"قسنطينة",
"المدية",
"مستغانم",
"المسيلة",
"معسكر",
"ورقلة",
"وهران",
"البيض",
"إليزي",
"برج بوعريريج",
"بومرداس",
"الطارف",
"تندوف",
"تيسمسيلت",
"الوادي",
"خنشلة",
"سوق أهراس",
"تيبازة",
"ميلة",
"عين الدفلى",
"النعامة",
"عين تموشنت",
"غرداية",
"غليزان",
"تيميمون",
"برج باجي مختار",
"أولاد جلال",
"بني عباس",
"عين صالح",
"عين قزام",
"تقرت",
"جانت",
"المغير",
"المنيعة"
];

const select = document.getElementById("wilayaSelect");

wilayas.forEach((name) => {
  const option = document.createElement("option");
  option.textContent = "ولاية " + name;
  option.value = name;
  select.appendChild(option);
});

function changeWilaya() {
  const name = select.value;
  document.getElementById("wilaya").textContent = "ولاية " + name;
}

async function startCamera() {

  const message = document.getElementById("message");

  try {

    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: "environment"
      },
      audio: false
    });

    document.getElementById("camera").srcObject = stream;

    message.style.display = "none";

  } catch (error) {

    message.innerHTML = `
      <h2>⚠️ لم يتم تشغيل الكاميرا</h2>
      <p>اسمح للموقع باستخدام الكاميرا ثم حاول مرة أخرى.</p>
      <button onclick="startCamera()">إعادة المحاولة 📷</button>
    `;

  }
}

</script>

</body>
</html>
