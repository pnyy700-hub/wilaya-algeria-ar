<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ولاية الجزائر AR</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #071b12;
  color: white;
  font-family: Arial, sans-serif;
  overflow: hidden;
}

#camera {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: #111;
}

.overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
}

.top {
  position: absolute;
  top: 25px;
  right: 15px;
  left: 15px;
  text-align: center;
}

.title {
  display: inline-block;
  background: rgba(0,0,0,.65);
  padding: 10px 18px;
  border-radius: 25px;
  font-size: 18px;
  font-weight: bold;
}

.wilaya-box {
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  min-width: 280px;
}

.flag {
  font-size: 55px;
  margin-bottom: 5px;
}

.wilaya {
  font-size: 38px;
  font-weight: bold;
  text-shadow:
    0 3px 8px #000,
    0 0 20px #00ff88;
}

.number {
  margin-top: 8px;
  font-size: 20px;
  background: rgba(0,0,0,.65);
  display: inline-block;
  padding: 7px 18px;
  border-radius: 20px;
}

.controls {
  position: fixed;
  bottom: 25px;
  left: 15px;
  right: 15px;
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

button, select {
  border: none;
  border-radius: 25px;
  padding: 13px 18px;
  font-size: 16px;
  font-weight: bold;
}

button {
  background: #008f4c;
  color: white;
}

button:active {
  transform: scale(.95);
}

select {
  background: white;
  color: #111;
  max-width: 220px;
}

#message {
  position: fixed;
  top: 100px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0,0,0,.75);
  padding: 10px 18px;
  border-radius: 20px;
  display: none;
}

.confetti {
  position: fixed;
  top: -20px;
  font-size: 25px;
  animation: fall 2s linear forwards;
  pointer-events: none;
}

@keyframes fall {
  to {
    transform: translateY(110vh) rotate(720deg);
    opacity: 0;
  }
}

.hidden {
  display: none;
}
</style>
</head>

<body>

<video id="camera" autoplay playsinline></video>

<div class="overlay">

  <div class="top">
    <div class="title">
      🇩🇿 ولاية الجزائر AR
    </div>
  </div>

  <div class="wilaya-box">
    <div class="flag">🇩🇿</div>

    <div class="wilaya" id="wilayaName">
      الجزائر
    </div>

    <div class="number" id="wilayaNumber">
      الولاية رقم 16
    </div>
  </div>

</div>

<div id="message">
  جارٍ تشغيل الكاميرا...
</div>

<div class="controls">

  <select id="wilayaSelect">
    <option value="">اختر ولاية</option>
  </select>

  <button onclick="startCamera()">
    📷 تشغيل الكاميرا
  </button>

  <button onclick="randomWilaya()">
    🎲 ولاية عشوائية
  </button>

  <button onclick="detectLocation()">
    📍 موقعي
  </button>

</div>

<script>

const wilayas = [
  ["01","أدرار"],
  ["02","الشلف"],
  ["03","الأغواط"],
  ["04","أم البواقي"],
  ["05","باتنة"],
  ["06","بجاية"],
  ["07","بسكرة"],
  ["08","بشار"],
  ["09","البليدة"],
  ["10","البويرة"],
  ["11","تمنراست"],
  ["12","تبسة"],
  ["13","تلمسان"],
  ["14","تيارت"],
  ["15","تيزي وزو"],
  ["16","الجزائر"],
  ["17","الجلفة"],
  ["18","جيجل"],
  ["19","سطيف"],
  ["20","سعيدة"],
  ["21","سكيكدة"],
  ["22","سيدي بلعباس"],
  ["23","عنابة"],
  ["24","قالمة"],
  ["25","قسنطينة"],
  ["26","المدية"],
  ["27","مستغانم"],
  ["28","المسيلة"],
  ["29","معسكر"],
  ["30","ورقلة"],
  ["31","وهران"],
  ["32","البيض"],
  ["33","إليزي"],
  ["34","برج بوعريريج"],
  ["35","بومرداس"],
  ["36","الطارف"],
  ["37","تندوف"],
  ["38","تيسمسيلت"],
  ["39","الوادي"],
  ["40","خنشلة"],
  ["41","سوق أهراس"],
  ["42","تيبازة"],
  ["43","ميلة"],
  ["44","عين الدفلى"],
  ["45","النعامة"],
  ["46","عين تموشنت"],
  ["47","غرداية"],
  ["48","غليزان"],
  ["49","تيميمون"],
  ["50","برج باجي مختار"],
  ["51","أولاد جلال"],
  ["52","بني عباس"],
  ["53","عين صالح"],
  ["54","عين قزام"],
  ["55","تقرت"],
  ["56","جانت"],
  ["57","المغير"],
  ["58","المنيعة"]
];

const select = document.getElementById("wilayaSelect");
const nameElement = document.getElementById("wilayaName");
const numberElement = document.getElementById("wilayaNumber");
const message = document.getElementById("message");

wilayas.forEach(w => {
  const option = document.createElement("option");
  option.value = w[0];
  option.textContent = w[0] + " - " + w[1];
  select.appendChild(option);
});

select.addEventListener("change", function() {

  if (!this.value) return;

  const wilaya = wilayas.find(w => w[0] === this.value);

  if (wilaya) {
    showWilaya(wilaya[0], wilaya[1]);
    celebration();
  }
});

function showWilaya(number, name) {

  nameElement.textContent = name;
  numberElement.textContent = "الولاية رقم " + number;

}

async function startCamera() {

  try {

    message.style.display = "block";
    message.textContent = "📷 جارٍ تشغيل الكاميرا...";

    const stream = await navigator.mediaDevices.getUserMedia({
      video: {
        facingMode: {
          ideal: "environment"
        }
      },
      audio: false
    });

    document.getElementById("camera").srcObject = stream;

    message.textContent = "✅ الكاميرا تعمل";

    setTimeout(() => {
      message.style.display = "none";
    }, 1500);

  } catch (error) {

    message.style.display = "block";
    message.textContent =
      "❌ لم يتم السماح باستخدام الكاميرا";

    console.log(error);
  }
}

function randomWilaya() {

  const index = Math.floor(Math.random() * wilayas.length);

  const wilaya = wilayas[index];

  select.value = wilaya[0];

  showWilaya(wilaya[0], wilaya[1]);

  celebration();
}

function celebration() {

  const symbols = ["🇩🇿","⭐","✨","🎉","💚","❤️"];

  for (let i = 0; i < 25; i++) {

    const item = document.createElement("div");

    item.className = "confetti";

    item.textContent =
      symbols[Math.floor(Math.random() * symbols.length)];

    item.style.left =
      Math.random() * 100 + "%";

    item.style.animationDuration =
      (1 + Math.random() * 2) + "s";

    document.body.appendChild(item);

    setTimeout(() => {
      item.remove();
    }, 3000);
  }
}

/*
  تحديد الولاية بواسطة موقع الهاتف.

  ملاحظة:
  GPS يعطي إحداثيات الهاتف، ولا يتعرف على الوجه.
  لذلك نستخدمه فقط للحصول على الموقع الجغرافي.
*/

function detectLocation() {

  if (!navigator.geolocation) {

    alert("المتصفح لا يدعم تحديد الموقع.");

    return;
  }

  message.style.display = "block";
  message.textContent = "📍 جارٍ تحديد موقعك...";

  navigator.geolocation.getCurrentPosition(

    function(position) {

      const lat = position.coords.latitude;
      const lon = position.coords.longitude;

      /*
        مناطق تقريبية لبعض الولايات.
        سيتم تطوير هذه الخريطة لاحقًا لتشمل حدود
        جميع الولايات بدقة أكبر.
      */

      let detected = nearestWilaya(lat, lon);

      if (detected) {

        select.value = detected[0];

        showWilaya(
          detected[0],
          detected[1]
        );

        message.textContent =
          "📍 تم تحديد موقع تقريبي";

        celebration();

      } else {

        message.textContent =
          "لم يتم التعرف على الولاية.";
      }

      setTimeout(() => {
        message.style.display = "none";
      }, 2500);

    },

    function(error) {

      message.textContent =
        "❌ اسمح للتطبيق باستخدام الموقع.";

      setTimeout(() => {
        message.style.display = "none";
      }, 2500);

    },

    {
      enableHighAccuracy: true,
      timeout: 10000,
      maximumAge: 60000
    }
  );
}

/*
  إحداثيات تقريبية لمراكز بعض الولايات.
*/

const locations = {

  "01":[27.87,-0.29],
  "02":[36.16,1.33],
  "03":[33.80,2.88],
  "04":[35.87,7.11],
  "05":[35.55,6.17],
  "06":[36.75,5.06],
  "07":[34.85,5.73],
  "08":[31.62,-2.22],
  "09":[36.47,2.83],
  "10":[36.38,3.90],
  "11":[22.79,5.52],
  "12":[35.40,8.12],
  "13":[34.88,-1.32],
  "14":[35.37,1.32],
  "15":[36.71,4.05],
  "16":[36.75,3.05],
  "17":[34.67,3.26],
  "18":[36.82,5.77],
  "19":[36.19,5.41],
  "20":[34.83,0.15],
  "21":[36.88,6.91],
  "22":[35.20,-0.63],
  "23":[36.90,7.76],
  "24":[36.46,7.43],
  "25":[36.36,6.61],
  "26":[36.26,2.75],
  "27":[35.93,0.09],
  "28":[35.70,4.54],
  "29":[35.40,0.14],
  "30":[31.95,5.33],
  "31":[35.70,-0.63],
  "32":[33.68,1.02],
  "33":[26.50,8.48],
  "34":[36.07,4.76],
  "35":[36.77,3.47],
  "36":[36.77,8.31],
  "37":[27.67,-8.15],
  "38":[35.61,1.81],
  "39":[33.36,6.86],
  "40":[35.43,7.14],
  "41":[36.29,7.95],
  "42":[36.59,2.44],
  "43":[36.45,6.26],
  "44":[36.26,1.97],
  "45":[33.27,-0.31],
  "46":[35.30,-1.14],
  "47":[32.49,3.67],
  "48":[35.74,0.56],
  "49":[29.26,0.23],
  "50":[21.33,0.95],
  "51":[34.54,5.74],
  "52":[30.13,-2.17],
  "53":[27.19,2.48],
  "54":[19.57,5.77],
  "55":[33.11,6.07],
  "56":[24.55,9.48],
  "57":[33.95,5.92],
  "58":[30.58,2.88]

};

function distance(lat1, lon1, lat2, lon2) {

  const R = 6371;

  const dLat =
    (lat2 - lat1) * Math.PI / 180;

  const dLon =
    (lon2 - lon1) * Math.PI / 180;

  const a =
    Math.sin(dLat / 2) *
    Math.sin(dLat / 2) +

    Math.cos(lat1 * Math.PI / 180) *
    Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon / 2) *
    Math.sin(dLon / 2);

  const c =
    2 * Math.atan2(
      Math.sqrt(a),
      Math.sqrt(1 - a)
    );

  return R * c;
}

function nearestWilaya(lat, lon) {

  let closest = null;
  let smallest = Infinity;

  for (const code in locations) {

    const point = locations[code];

    const d = distance(
      lat,
      lon,
      point[0],
      point[1]
    );

    if (d < smallest) {

      smallest = d;

      const w =
        wilayas.find(x => x[0] === code);

      closest = w;
    }
  }

  return closest;
}

</script>

</body>
</html>
